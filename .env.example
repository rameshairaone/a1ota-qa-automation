# Copy to .env (git-ignored) and fill in. These override config/.env.<TEST_ENV>.

# Single sign-on (Microsoft Entra ID). When SSO_USER is set, setup logs in by SSO.
# Leave SSO_PASSWORD empty to type the password and approve MFA yourself in a headed run
# (npm run auth:sso); the session is then saved to .auth/user.json and reused.
SSO_USER=
SSO_PASSWORD=
# SSO_MANUAL_TIMEOUT_MS=180000

# Email/password form login (used when SSO_USER is empty)
STANDARD_USER=
STANDARD_PASSWORD=
ADMIN_USER=
ADMIN_PASSWORD=

API_TOKEN=
# HEADLESS=false
# SLOW_MO=500
# Use installed Chrome/Edge instead of the bundled Chromium (e.g. if Windows blocks it): chrome | msedge
# BROWSER_CHANNEL=chrome

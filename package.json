{
  "name": "a1ota-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI + API test automation framework built on Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:positive": "playwright test --grep @positive",
    "test:negative": "playwright test --grep @negative",
    "test:no-login": "playwright test --no-deps --grep-invert @needs-login --project=chromium --project=api",
    "test:headed": "cross-env SLOW_MO=500 playwright test --headed --project=chromium --workers=1",
    "auth:sso": "playwright test --project=setup --headed",
    "test:debug": "playwright test --debug --project=chromium",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "report": "playwright show-report reports/html",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@faker-js/faker": "^9.2.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "eslint-plugin-playwright": "^2.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}

# QA environment: no secrets here. Put credentials in the root .env file or in CI secrets.
# Both URLs end with "/", and paths in page objects and services have no leading slash,
# so "dashboard" resolves to .../admin/dashboard rather than .../dashboard.
BASE_URL=https://morningstar-a1.azurewebsites.net/admin/
API_URL=https://morningstar-a1.azurewebsites.net/uiapi/
# false = show the browser. CI always runs headless regardless (see src/config/env.ts).
HEADLESS=false